# The hostname Caddy serves (and gets a certificate for).
BOARD_DOMAIN=board.example.com

# Postgres service. Keep the password URL-safe (letters/digits), or set
# UKB_PG_URL explicitly below.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=ukb
# POSTGRES_DB=ukb
# POSTGRES_IMAGE=postgres:16
# UKB_PG_URL=postgres://ukb:change-me@postgres:5432/ukb

# Uncomment only while migrating a board over HTTP, then remove and restart.
# UKB_ALLOW_IMPORT=1

# Personal/trusted board only: no login challenge and no per-card guard
# (anonymous writes). Leave unset for a shared board.
# UKB_AUTH=off

# Use a published image instead of building locally (Release workflow).
# UKB_IMAGE=ghcr.io/wayblink/using-kanban:latest

# Optional: base images and package registry for networks that need mirrors.
# NODE_IMAGE=node:22-bookworm
# NODE_RUNTIME_IMAGE=node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmjs.org
