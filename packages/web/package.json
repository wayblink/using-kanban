{
  "name": "@wayblink/using-kanban-web",
  "version": "0.1.0",
  "description": "Default Web UI for using-kanban \u2014 zero-build, zero-dependency, drag & drop, live over SSE",
  "author": "wayblink",
  "homepage": "https://github.com/wayblink/using-kanban#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayblink/using-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/wayblink/using-kanban/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "kanban",
    "agents",
    "web-ui",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.html",
  "exports": {
    ".": "./dist/index.html",
    "./package.json": "./package.json",
    "./dist/index.html": "./dist/index.html",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/inline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node --check src/app.js && node --check scripts/inline.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "drag-check": "node scripts/drag-check.mjs"
  },
  "devDependencies": {
    "@wayblink/using-kanban-server": "workspace:*",
    "vitest": "^3.2.4"
  }
}
