{
  "name": "@using-kanban/web",
  "version": "0.1.0",
  "description": "Default Web UI for using-kanban — zero-build, zero-dependency, drag & drop, live over SSE",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "kanban",
    "agents",
    "web-ui",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.html",
  "exports": {
    ".": "./dist/index.html",
    "./dist/index.html": "./dist/index.html",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/inline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node --check src/app.js && node --check scripts/inline.mjs"
  },
  "devDependencies": {
    "@using-kanban/server": "workspace:*",
    "vitest": "^3.2.4"
  }
}
